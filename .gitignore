# Local IDE settings, caches and Copilot indexes
.vs/
*.suo
*.user
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.ipch
ipch/

# Build output folders (Debug/Release, any platform)
**/[Dd]ebug/*
**/[Rr]elease/*
x64/
x86/
Win32/

# Keep the runtime DLLs that the game needs next to the .exe
!**/[Dd]ebug/*.dll
!**/[Rr]elease/*.dll

# Build logs and intermediate files
*.tlog
*.lastbuildstate
*.log
*.idb
*.pdb
*.ilk
*.recipe
*.tmp
*FileListAbsolute.txt

# C++ build files
*.d
*.o
*.slo
*.lo
*.gch
*.pch
*.dwo
*.so
*.dylib
*.a
*.la
*.lai

# Executables
*.exe
*.out
*.app

# Game save files (made when the game runs)
GP2/Lab1/highscore.txt
GP2/Lab1/stats.txt

# OS files
.DS_Store
Thumbs.db
desktop.ini
